@startuml 
title class diagram(design)

class File {
- textFileName : String
- filePath : String
- fileContent : String
--
+ File()
+ readFile(): File
+ newTextFile(): File
+ readTextFile(): String
+ setTextFileName(textFileName : String): void
+ getTextFileName(): String
+ getName(): String
+ getFileContent(): String
+ setFileContent(fileContent: String): void
}
	
class TextFileManager{
- currentFile : File
+ openTextFile():File
+ createNewTextFile(): File
+ SaveTextFile(file: File): boolean
+ saveTextFile(): boolean
+ closeTextFile(): File
+ saveFileAs(): void
}





class View{ 
- controller: Controller
- currentFile: File
--
+ chooseOpen(): void
+ chooseCreate(): void
+ chooseExit(): void
+ chooseSave(): void
+ chooseSaveAs(): void
+ inputFileName(): String
+ viewCurrent(file: File): void
+ closeView(file: File): void
+ savingTextFile(file: File): void


}

class Controller{ 
- textFileManager : TextFileManager
--
+ handleEvent(event: Event): void
+ createFile(): void
+ openFile(): void
+ exitTexteditor(): void
+ saveFile():void
+ saveFileAs(textFileName : String): void
}

enum Event {
OPEN
CREATE
EXIT
SAVE
SAVE_AS
}


Controller --> "1" TextFileManager
TextFileManager "1" -->  File
Controller --> File
Controller --> "1" View


@enduml
