@startuml 
title user case: Notepad
left to right direction
skinparam packageStyle rect
actor user
package Notepad {
user -- (edit text)
user -- (start Notepad)
user -- (open text file)
user -- (copy text)
user -- (cut text)
user -- (paste text)
user -- (save)
user -- (save as)
(save) .> (save as) :include
user -- (exit Notepad)
}
@enduml
